      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Distribution.
       JitPack continues to serve every git tag on demand under
       `com.github.giskardb.gargantua` (JitPack rewrites the groupId at
       upload time, so the internal `io.github.giskardb` here doesn't
       break anything for JitPack consumers).

       The `release` profile below adds source + javadoc jars, GPG signing
       and the Sonatype Central Publishing plugin so that tagging
       v*.*.* on `main` (or running the release-maven-central workflow
       manually) publishes signed artifacts to Maven Central. See
       .github/workflows/release-maven-central.yml. -->

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
        <plugin>
          <groupId>org.graalvm.buildtools</groupId>
          <artifactId>native-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Activate with `mvn -Prelease deploy` — invoked by the
      release-maven-central GitHub Actions workflow on every v*.*.* tag.
      Never activate locally for normal builds: the GPG-sign step requires
      a private key + passphrase that only the CI has.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- 1. Attach -sources.jar (required by Maven Central) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!-- 2. Attach -javadoc.jar (required by Maven Central) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <!-- Tolerant settings: don't fail the release if a
                       single javadoc comment is malformed. -->
                  <doclint>none</doclint>
                  <failOnError>false</failOnError>
                  <quiet>true</quiet>
                  <detectJavaApiLink>false</detectJavaApiLink>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- 3. GPG-sign every artifact (jar + sources + javadoc + pom) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- The CI imports the key via actions/setup-java's
                       gpg-private-key input, which also sets GPG_TTY and
                       configures gpg2 — we just need to tell the plugin
                       to read the passphrase from the env var. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- 4. Upload + release to Maven Central via the Central Portal API -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- autoPublish=true tells the portal to release immediately
                   if validation passes. Flip to false if you want a manual
                   "Publish" click on https://central.sonatype.com first. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
