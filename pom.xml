         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.giskardb</groupId>
  <artifactId>gargantua-parent</artifactId>
  <version>1.2.20</version>
  <packaging>pom</packaging>
  <name>Gargantua AI Agent Framework</name>
  <description>
    Production-ready AI agent framework for Java. Built on Spring Boot 4 and LangChain4j,
    Gargantua turns Java methods (@AgentTool) and Markdown files (SKILL.md) into a deployable
    agent service with skills, hybrid routing, 3-layer memory, guardrails, human-in-the-loop
    approvals, multi-provider LLM failover, RAG with a pluggable EmbeddingPort, A2A protocol,
    MCP server gateway, cost tracking and an immutable audit trail. Ships an embedded
    zero-infra mode for tests and demos.
  </description>
  <url>https://github.com/GiskardB/gargantua</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>giskardb</id>
      <name>Giuseppe Brescia</name>
      <email>giskard80@gmail.com</email>
      <url>https://github.com/GiskardB</url>
      <roles>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/GiskardB/gargantua.git</connection>
    <developerConnection>scm:git:git@github.com:GiskardB/gargantua.git</developerConnection>
    <url>https://github.com/GiskardB/gargantua</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/GiskardB/gargantua/issues</url>
  </issueManagement>

  <modules>
    <module>agent-core</module>
    <module>agent-memory-sdk</module>
    <module>agent-engine</module>
    <module>agent-mcp-server</module>
    <module>agent-skill-linter-maven-plugin</module>
    <module>agent-archetype</module>
  </modules>

  <!-- Reference agents live in a sibling repo:
       https://github.com/GiskardB/gargantua-examples -->


  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.4</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <langchain4j.version>1.12.1</langchain4j.version>
    <springdoc.version>3.0.2</springdoc.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <caffeine.version>3.2.0</caffeine.version>
    <json-schema-validator.version>1.5.4</json-schema-validator.version>
    <flexmark.version>0.64.8</flexmark.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <wiremock.version>3.10.0</wiremock.version>
    <mcp-sdk.version>0.9.0</mcp-sdk.version>

    <!-- Release-time plugin versions (used by the `release` profile below) -->
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
  </properties>

  <dependencyManagement>
