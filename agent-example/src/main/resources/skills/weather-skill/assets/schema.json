{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather-skill-output",
  "title": "Weather Skill Output Schema",
  "description": "Validates the structured output of the weather skill",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/currentWeather" },
    { "$ref": "#/$defs/forecast" },
    { "$ref": "#/$defs/alert" }
  ],
  "$defs": {
    "currentWeather": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "current"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "temperatureCelsius": {
          "type": "number"
        },
        "condition": {
          "type": "string"
        },
        "humidityPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "windSpeedKmh": {
          "type": "number",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "city", "temperatureCelsius", "condition"],
      "additionalProperties": false
    },
    "forecast": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "forecast"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "highCelsius": {
                "type": "number"
              },
              "lowCelsius": {
                "type": "number"
              },
              "condition": {
                "type": "string"
              },
              "precipitationPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": ["date", "highCelsius", "lowCelsius", "condition"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": ["type", "city", "days"],
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "alert"
        },
        "sent": {
          "type": "boolean"
        },
        "alertType": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "sent", "alertType", "message"],
      "additionalProperties": false
    }
  }
}
