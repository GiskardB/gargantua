# ═══════════════════════════════════════════════════════════════════
# Gargantua Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# Start infrastructure: docker compose up -d mongo redis ollama
# Pull routing model:   docker compose exec ollama ollama pull phi4-mini
# ═══════════════════════════════════════════════════════════════════

# ── Infrastructure ────────────────────────────────────────────────
# MongoDB, Redis, and Ollama must be running.
MONGODB_URI=mongodb://localhost:27017/my-agent
REDIS_URL=redis://localhost:6379

# ── Primary LLM Provider (MANDATORY) ─────────────────────────────
# At minimum you need an API key for one LLM provider.
# Supported providers: openai, azure-openai, anthropic
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o
LLM_PRIMARY_API_KEY=sk-your-key-here
# LLM_PRIMARY_ENDPOINT=            # Required only for azure-openai
# LLM_PRIMARY_TEMPERATURE=0.7
# LLM_PRIMARY_MAX_TOKENS=1000

# ── Fallback LLM (optional) ──────────────────────────────────────
# Used automatically when the primary provider fails (timeout, 5xx, rate limit).
# Backed by Resilience4j circuit breaker.
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=claude-sonnet-4-20250514
# LLM_FALLBACK_API_KEY=

# ── Routing Model ────────────────────────────────────────────────
# Runs locally via Ollama by default — zero API cost.
# Used for: skill routing, session summaries, eval judge.
# Override only if you prefer a cloud provider for routing.
LLM_ROUTING_PROVIDER=ollama
LLM_ROUTING_MODEL=phi4-mini
LLM_ROUTING_ENDPOINT=http://localhost:11434
# LLM_ROUTING_API_KEY=             # Not needed for Ollama

# ── Server ────────────────────────────────────────────────────────
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev
