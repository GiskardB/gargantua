<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
    xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
        http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
    name="agent-archetype">

  <requiredProperties>
    <requiredProperty key="agentName">
      <defaultValue>MyAgent</defaultValue>
    </requiredProperty>
  </requiredProperties>

  <fileSets>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/test/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>src/main/resources</directory>
      <includes>
        <include>**/*.yml</include>
        <include>**/*.md</include>
        <include>**/*.json</include>
        <include>**/*.html</include>
      </includes>
    </fileSet>
    <!-- Files that MUST be Velocity-filtered (use ${artifactId}, ${symbol_dollar}, etc.) -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>docker-compose.yml</include>
      </includes>
    </fileSet>
    <!-- Static files copied verbatim. Note: .gitignore ships as "gitignore"
         (no leading dot) in the archetype JAR because Maven's DirectoryScanner
         DEFAULTEXCLUDES drop ".git*" entries; the archetype-post-generate.groovy
         script renames it to .gitignore in the generated project. -->
    <fileSet filtered="false" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>gitignore</include>
        <include>.env.example</include>
        <include>Dockerfile</include>
      </includes>
    </fileSet>
  </fileSets>
</archetype-descriptor>
